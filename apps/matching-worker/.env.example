# Optional local settings. Copy the --batch-ticket / --api-base-url command from
# the dashboard, exactly like tailoring. No Supabase URL/key is needed here.
# Default: saved Codex ChatGPT login, just like tailoring. No OpenAI API key needed.
MATCHING_PROVIDER=codex
# The ticket supplies the database-configured model. Optional assertion:
# MATCHING_MODEL=gpt-5.6-luna
MATCHING_CONCURRENCY=1
MATCHING_CODEX_REASONING_EFFORT=low
MATCHING_CODEX_SERVICE_TIER=default
# Optional when codex is not on PATH (TAILORING_CODEX_BIN is also accepted).
# MATCHING_CODEX_BIN=C:\path\to\codex.exe

# Optional alternative, never an automatic fallback:
# MATCHING_PROVIDER=openai
# OPENAI_API_KEY=
