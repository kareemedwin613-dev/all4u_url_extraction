{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume tailoring generation output v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "professionalExperience",
    "skills"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "professionalExperience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceExperienceId", "tailoredDetails"],
        "properties": {
          "sourceExperienceId": { "type": "string", "minLength": 1, "maxLength": 120 },
          "tailoredDetails": { "type": "string", "minLength": 1, "maxLength": 12000 }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Additional project-essential technologies that are absent from the supplied JD and candidate skill lists.",
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    }
  }
}
