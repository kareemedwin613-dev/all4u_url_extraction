NODE_ENV=development
PORT=3000
API_BASE_PATH=api/v1
CORS_ORIGINS=http://localhost:4174,http://localhost:4175,http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_OR_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Optional. Supabase secret (admin) key, used only by the extension-pairing module to create a
# separate session when a signed-in dashboard approves the Chrome extension. Leave empty to
# disable "Connect with dashboard"; never expose this key to the dashboard or extension.
SUPABASE_SECRET_KEY=
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=60
INGESTION_RATE_LIMIT_MAX=20
LOG_LEVEL=info
SWAGGER_ENABLED=true
