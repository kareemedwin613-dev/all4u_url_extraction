    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docx": "^9.7.1",
    "joi": "^18.0.1",
    "jose": "^6.1.0",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
